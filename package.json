{
  "name": "dsh-claudelike-ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A non-destructive claude.ai-inspired visual skin for DeepSeek Harness.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "assets"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "prepare": "npm run build 1>&2",
    "test": "npm run build && node --check index.js && node --check client.js"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-theme"]
    }
  }
}
