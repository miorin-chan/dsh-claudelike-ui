{
  "name": "dsh-claudelike-ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A non-destructive claude.ai-inspired visual skin for DeepSeek Harness.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "assets"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "npm run build 1>&2",
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm run build && npm run test:unit",
    "test:unit": "node --test",
    "check": "npm run typecheck && node scripts/build.mjs --check && node scripts/sync-types.mjs --check && npm run test:unit"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-client-ui-theme": "0.2.2-rc.5",
    "typescript": "5.9.3"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-theme"]
    }
  }
}
