{
  "name": "@miorin/dsh-claudelike-ui",
  "version": "1.0.0",
  "type": "module",
  "description": "A non-destructive claude.ai-inspired visual skin for DeepSeek Harness.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.5"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "README.zh.md",
    "AGENTS.md",
    "AGENTS.local.md",
    "docs/README.md",
    "docs",
    "icon.svg",
    "assets"
  ],
  "scripts": {
    "build:tools": "tsc -p tsconfig.tools.json",
    "build": "npm run build:tools && node scripts/build.mjs",
    "prepare": "npm run build 1>&2",
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm run build && npm run test:unit",
    "test:unit": "node --test",
    "check": "npm run build:tools && npm run typecheck && node scripts/build.mjs --check && node scripts/sync-types.mjs --check && npm run test:unit"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-theme": "0.2.2-rc.5",
    "@types/node": "22.20.5",
    "@types/react": "18.3.12",
    "typescript": "5.9.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miorin-chan/dsh-claudelike-ui.git"
  },
  "homepage": "https://github.com/miorin-chan/dsh-claudelike-ui#readme",
  "bugs": {
    "url": "https://github.com/miorin-chan/dsh-claudelike-ui/issues"
  }
}
